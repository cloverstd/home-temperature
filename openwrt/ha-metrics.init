#!/bin/sh /etc/rc.common
# OpenWrt procd service for the HA metrics collector.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/ha-metrics.sh

start_service() {
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
